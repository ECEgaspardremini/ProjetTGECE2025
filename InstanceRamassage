public class InstanceRamassage {

    private final GrapheRoutier graphe;
    private final int idDepot;
    private final EncombrantSurRue encombrant;

    public InstanceRamassage(GrapheRoutier graphe, int idDepot, EncombrantSurRue encombrant) {
        this.graphe = graphe;
        this.idDepot = idDepot;
        this.encombrant = encombrant;
    }

    public GrapheRoutier getGraphe() {
        return graphe;
    }

    public int getIdDepot() {
        return idDepot;
    }

    public EncombrantSurRue getEncombrant() {
        return encombrant;
    }
}
